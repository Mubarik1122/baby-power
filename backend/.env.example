PORT=5001
MONGODB_URI=mongodb://localhost:27017/little_star
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@littlestar.co.uk
ADMIN_PASSWORD=Admin@123456
# Optional — when set, uploads are stored in Cloudinary (shared across all devices/servers)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_FOLDER=little-star
# Optional — WhatsApp floating button (also editable in Admin → Settings)
# WHATSAPP_NUMBER=+447123456789
# WHATSAPP_MESSAGE=Hello, I have a question about Little Star wholesale.
# Set to true to use in-memory MongoDB (settings reset when dev stops)
# USE_MEMORY_DB=true
