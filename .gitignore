# Dependencies
node_modules/

# Environment & secrets (never commit)
.env
.env.*
!.env.example
!.env.local.example

# Next.js / frontend build
frontend/.next/
frontend/out/
frontend/build/

# Backend build & runtime
backend/dist/
backend/build/

# User uploads (keep folder, ignore files)
backend/uploads/*
!backend/uploads/.gitkeep

# Logs & debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test coverage
coverage/

# OS files
.DS_Store
Thumbs.db

# Editor / IDE (local only)
.idea/
.vscode/
*.swp
*.swo
*~

# Vercel / deploy
.vercel/

# TypeScript
*.tsbuildinfo

# Misc caches
.turbo/
.cache/
