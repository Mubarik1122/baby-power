{
  "name": "little-star",
  "version": "1.0.0",
  "description": "Little Star - Wholesale Baby Clothing Website",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-with-memory.js",
    "dev:local": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "install:all": "cd backend && npm install && cd ../frontend && npm install",
    "seed": "cd backend && npm run seed",
    "seed:memory": "node scripts/seed-with-memory.js",
    "mongo:docker": "docker compose up -d",
    "build": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
